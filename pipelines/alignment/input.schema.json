{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "dataset_kind", "provenance", "snapshot_id", "segmentation_recipe", "block_id", "source_language", "target_language", "source", "target"],
  "properties": {
    "schema_version": {"const": "alignment-eval/v1"},
    "dataset_kind": {"enum": ["constructed_smoke", "public_benchmark", "domain_gold"]},
    "provenance": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "segmentation_recipe": {"type": "string", "minLength": 1},
    "block_id": {"type": "string", "minLength": 1},
    "source_language": {"const": "zh"},
    "target_language": {"const": "en"},
    "source": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/segment"}},
    "target": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/segment"}},
    "annotation": {"type": "object", "required": ["independent_domain_annotators", "protocol"], "properties": {"independent_domain_annotators": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "protocol": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "reference_pairs": {"type": "array", "uniqueItems": true, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 1}}}
  },
  "allOf": [{"if": {"properties": {"dataset_kind": {"const": "domain_gold"}}}, "then": {"required": ["annotation", "reference_pairs"]}}],
  "additionalProperties": false,
  "$defs": {"segment": {"type": "object", "required": ["id", "revision_id", "text"], "properties": {"id": {"type": "string", "minLength": 1}, "revision_id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}}, "additionalProperties": false}}
}
