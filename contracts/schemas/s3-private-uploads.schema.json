{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus.invalid/contracts/s3-private-uploads.schema.json",
  "$defs": {
    "ValidatedUploadView": {
      "additionalProperties": false,
      "properties": {
        "upload_id": {
          "format": "uuid",
          "title": "Upload Id",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "state": {
          "const": "VALIDATED",
          "title": "State",
          "type": "string"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "size": {
          "maximum": 100000000,
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "job_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Job Id"
        }
      },
      "required": [
        "upload_id",
        "project_id",
        "state",
        "filename",
        "size",
        "sha256",
        "media_type",
        "expires_at",
        "job_id"
      ],
      "title": "ValidatedUploadView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/ValidatedUploadView"
      },
      "title": "Items",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Cursor"
    }
  },
  "required": [
    "items",
    "next_cursor"
  ],
  "title": "ValidatedUploadList",
  "type": "object"
}
