{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus.invalid/contracts/s3-index-list.schema.json",
  "type": "object",
  "properties": {
    "source_id": {
      "const": "D12"
    },
    "cursor": {
      "type": "string",
      "maxLength": 512
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "task_kind": {
      "const": "source_index"
    }
  },
  "required": [
    "source_id",
    "task_kind"
  ],
  "additionalProperties": false
}
