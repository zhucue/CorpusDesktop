{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus.invalid/contracts/s3-release-policy-update.schema.json",
  "type": "object",
  "properties": {
    "policy_kind": {
      "const": "source"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "acquisition_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "decision": {
      "enum": [
        "allow",
        "deny"
      ]
    },
    "review_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "evidence_urls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "pattern": "^https?://",
        "maxLength": 2048
      }
    }
  },
  "required": [
    "policy_kind",
    "source_id",
    "acquisition_id",
    "expected_revision",
    "decision",
    "review_note",
    "evidence_urls"
  ],
  "additionalProperties": false
}
