{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus.invalid/contracts/s3-private-material.schema.json",
  "$defs": {
    "MaterialCounts": {
      "additionalProperties": false,
      "properties": {
        "documents": {
          "const": 1,
          "title": "Documents",
          "type": "integer"
        },
        "segments": {
          "minimum": 1,
          "title": "Segments",
          "type": "integer"
        },
        "characters": {
          "minimum": 1,
          "title": "Characters",
          "type": "integer"
        }
      },
      "required": [
        "documents",
        "segments",
        "characters"
      ],
      "title": "MaterialCounts",
      "type": "object"
    },
    "MaterialQuality": {
      "additionalProperties": false,
      "properties": {
        "complete_text_preserved": {
          "const": true,
          "title": "Complete Text Preserved",
          "type": "boolean"
        },
        "rejected_segments": {
          "const": 0,
          "title": "Rejected Segments",
          "type": "integer"
        },
        "segmentation": {
          "const": "deterministic_rules_not_linguistic_gold",
          "title": "Segmentation",
          "type": "string"
        }
      },
      "required": [
        "complete_text_preserved",
        "rejected_segments",
        "segmentation"
      ],
      "title": "MaterialQuality",
      "type": "object"
    },
    "MaterialRevisionView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "material_id": {
          "format": "uuid",
          "title": "Material Id",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "upload_id": {
          "format": "uuid",
          "title": "Upload Id",
          "type": "string"
        },
        "language": {
          "enum": [
            "cmn",
            "eng"
          ],
          "title": "Language",
          "type": "string"
        },
        "recipe": {
          "$ref": "#/$defs/RecipeView"
        },
        "manifest_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "canonical_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Canonical Sha256",
          "type": "string"
        },
        "counts": {
          "$ref": "#/$defs/MaterialCounts"
        },
        "quality": {
          "$ref": "#/$defs/MaterialQuality"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "material_id",
        "project_id",
        "revision",
        "upload_id",
        "language",
        "recipe",
        "manifest_sha256",
        "canonical_sha256",
        "counts",
        "quality",
        "created_at"
      ],
      "title": "MaterialRevisionView",
      "type": "object"
    },
    "RecipeView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "title": "RecipeView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "language": {
      "enum": [
        "cmn",
        "eng"
      ],
      "title": "Language",
      "type": "string"
    },
    "state": {
      "enum": [
        "IMPORTING",
        "READY",
        "FAILED",
        "CANCELLED"
      ],
      "title": "State",
      "type": "string"
    },
    "import_id": {
      "format": "uuid",
      "title": "Import Id",
      "type": "string"
    },
    "latest_revision": {
      "anyOf": [
        {
          "$ref": "#/$defs/MaterialRevisionView"
        },
        {
          "type": "null"
        }
      ]
    },
    "revisions": {
      "items": {
        "$ref": "#/$defs/MaterialRevisionView"
      },
      "title": "Revisions",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "project_id",
    "name",
    "language",
    "state",
    "import_id",
    "latest_revision",
    "revisions",
    "created_at"
  ],
  "title": "MaterialView",
  "type": "object"
}
