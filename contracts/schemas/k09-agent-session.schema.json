{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus.invalid/contracts/k09-agent-session.schema.json",
  "$defs": {
    "AccountScope": {
      "additionalProperties": false,
      "properties": {
        "scope_kind": {
          "const": "account",
          "title": "Scope Kind",
          "type": "string"
        }
      },
      "required": [
        "scope_kind"
      ],
      "title": "AccountScope",
      "type": "object"
    },
    "PlatformScope": {
      "additionalProperties": false,
      "properties": {
        "scope_kind": {
          "const": "platform",
          "title": "Scope Kind",
          "type": "string"
        }
      },
      "required": [
        "scope_kind"
      ],
      "title": "PlatformScope",
      "type": "object"
    },
    "ProjectScope": {
      "additionalProperties": false,
      "properties": {
        "scope_kind": {
          "const": "project",
          "title": "Scope Kind",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "snapshot_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 0,
          "title": "Snapshot Ids",
          "type": "array"
        },
        "material_revision_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 0,
          "title": "Material Revision Ids",
          "type": "array"
        },
        "alignment_overlay_revision": {
          "default": null,
          "title": "Alignment Overlay Revision",
          "type": "null"
        },
        "result_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 0,
          "title": "Result Refs",
          "type": "array"
        }
      },
      "required": [
        "scope_kind",
        "project_id"
      ],
      "title": "ProjectScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "scope": {
      "discriminator": {
        "mapping": {
          "account": "#/$defs/AccountScope",
          "platform": "#/$defs/PlatformScope",
          "project": "#/$defs/ProjectScope"
        },
        "propertyName": "scope_kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AccountScope"
        },
        {
          "$ref": "#/$defs/PlatformScope"
        },
        {
          "$ref": "#/$defs/ProjectScope"
        }
      ],
      "title": "Scope"
    },
    "scope_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Scope Digest",
      "type": "string"
    },
    "config_id": {
      "pattern": "^(local-fixture-v1|openai-[a-f0-9]{48})$",
      "title": "Config Id",
      "type": "string"
    },
    "active_run_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Active Run Id"
    },
    "latest_checkpoint_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Latest Checkpoint Id"
    },
    "lease_epoch": {
      "minimum": 0,
      "title": "Lease Epoch",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "scope",
    "scope_digest",
    "config_id",
    "active_run_id",
    "latest_checkpoint_id",
    "lease_epoch",
    "created_at"
  ],
  "title": "SessionView",
  "type": "object"
}
