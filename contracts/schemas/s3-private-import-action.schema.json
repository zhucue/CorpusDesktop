{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus.invalid/contracts/s3-private-import-action.schema.json",
  "$defs": {
    "ImportActions": {
      "additionalProperties": false,
      "properties": {
        "cancel": {
          "title": "Cancel",
          "type": "boolean"
        },
        "retry": {
          "title": "Retry",
          "type": "boolean"
        }
      },
      "required": [
        "cancel",
        "retry"
      ],
      "title": "ImportActions",
      "type": "object"
    },
    "ImportView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "job_id": {
          "format": "uuid",
          "title": "Job Id",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "actor_id": {
          "format": "uuid",
          "title": "Actor Id",
          "type": "string"
        },
        "upload_id": {
          "format": "uuid",
          "title": "Upload Id",
          "type": "string"
        },
        "material_id": {
          "format": "uuid",
          "title": "Material Id",
          "type": "string"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "language": {
          "enum": [
            "cmn",
            "eng"
          ],
          "title": "Language",
          "type": "string"
        },
        "recipe": {
          "$ref": "#/$defs/RecipeView"
        },
        "state": {
          "enum": [
            "QUEUED",
            "RUNNING",
            "SUCCEEDED",
            "FAILED",
            "CANCELLED"
          ],
          "title": "State",
          "type": "string"
        },
        "stage": {
          "enum": [
            "QUEUED",
            "FETCHING",
            "PARSING",
            "STORING",
            "COMPLETE",
            "FAILED",
            "CANCELLED"
          ],
          "title": "Stage",
          "type": "string"
        },
        "attempt": {
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "progress": {
          "$ref": "#/$defs/ResearchProgress"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResearchError"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/MaterialRevisionView"
            },
            {
              "type": "null"
            }
          ]
        },
        "allowed_actions": {
          "$ref": "#/$defs/ImportActions"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "job_id",
        "project_id",
        "actor_id",
        "upload_id",
        "material_id",
        "filename",
        "language",
        "recipe",
        "state",
        "stage",
        "attempt",
        "progress",
        "error",
        "result",
        "allowed_actions",
        "created_at",
        "updated_at"
      ],
      "title": "ImportView",
      "type": "object"
    },
    "MaterialCounts": {
      "additionalProperties": false,
      "properties": {
        "documents": {
          "const": 1,
          "title": "Documents",
          "type": "integer"
        },
        "segments": {
          "minimum": 1,
          "title": "Segments",
          "type": "integer"
        },
        "characters": {
          "minimum": 1,
          "title": "Characters",
          "type": "integer"
        }
      },
      "required": [
        "documents",
        "segments",
        "characters"
      ],
      "title": "MaterialCounts",
      "type": "object"
    },
    "MaterialQuality": {
      "additionalProperties": false,
      "properties": {
        "complete_text_preserved": {
          "const": true,
          "title": "Complete Text Preserved",
          "type": "boolean"
        },
        "rejected_segments": {
          "const": 0,
          "title": "Rejected Segments",
          "type": "integer"
        },
        "segmentation": {
          "const": "deterministic_rules_not_linguistic_gold",
          "title": "Segmentation",
          "type": "string"
        }
      },
      "required": [
        "complete_text_preserved",
        "rejected_segments",
        "segmentation"
      ],
      "title": "MaterialQuality",
      "type": "object"
    },
    "MaterialRevisionView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "material_id": {
          "format": "uuid",
          "title": "Material Id",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "upload_id": {
          "format": "uuid",
          "title": "Upload Id",
          "type": "string"
        },
        "language": {
          "enum": [
            "cmn",
            "eng"
          ],
          "title": "Language",
          "type": "string"
        },
        "recipe": {
          "$ref": "#/$defs/RecipeView"
        },
        "manifest_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "canonical_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Canonical Sha256",
          "type": "string"
        },
        "counts": {
          "$ref": "#/$defs/MaterialCounts"
        },
        "quality": {
          "$ref": "#/$defs/MaterialQuality"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "material_id",
        "project_id",
        "revision",
        "upload_id",
        "language",
        "recipe",
        "manifest_sha256",
        "canonical_sha256",
        "counts",
        "quality",
        "created_at"
      ],
      "title": "MaterialRevisionView",
      "type": "object"
    },
    "RecipeView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "title": "RecipeView",
      "type": "object"
    },
    "ResearchError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "ResearchError",
      "type": "object"
    },
    "ResearchProgress": {
      "additionalProperties": false,
      "properties": {
        "processed_bytes": {
          "minimum": 0,
          "title": "Processed Bytes",
          "type": "integer"
        },
        "total_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Total Bytes"
        },
        "processed_records": {
          "minimum": 0,
          "title": "Processed Records",
          "type": "integer"
        },
        "total_records": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Total Records"
        },
        "file_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "File Name"
        }
      },
      "required": [
        "processed_bytes",
        "total_bytes",
        "processed_records",
        "total_records",
        "file_name"
      ],
      "title": "ResearchProgress",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "format": "uuid",
      "title": "Action Id",
      "type": "string"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "import_id": {
      "format": "uuid",
      "title": "Import Id",
      "type": "string"
    },
    "state": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "State",
      "type": "string"
    },
    "run": {
      "$ref": "#/$defs/ImportView"
    }
  },
  "required": [
    "action_id",
    "job_id",
    "import_id",
    "state",
    "run"
  ],
  "title": "ImportAction",
  "type": "object"
}
