{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus.invalid/contracts/s3-research-context.schema.json",
  "$defs": {
    "HitRef": {
      "additionalProperties": false,
      "properties": {
        "result_set_id": {
          "format": "uuid",
          "title": "Result Set Id",
          "type": "string"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        }
      },
      "required": [
        "result_set_id",
        "ordinal"
      ],
      "title": "HitRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "hit_ref": {
      "$ref": "#/$defs/HitRef"
    },
    "revision_id": {
      "title": "Revision Id",
      "type": "string"
    },
    "segment_id": {
      "title": "Segment Id",
      "type": "string"
    },
    "origin_kind": {
      "enum": [
        "source",
        "private"
      ],
      "title": "Origin Kind",
      "type": "string"
    },
    "document_id": {
      "minLength": 1,
      "title": "Document Id",
      "type": "string"
    },
    "document_name": {
      "title": "Document Name",
      "type": "string"
    },
    "material_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Material Id"
    },
    "material_revision_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Material Revision Id"
    },
    "source_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Id"
    },
    "source_sentence_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Sentence Id"
    },
    "context_start_cp": {
      "minimum": 0,
      "title": "Context Start Cp",
      "type": "integer"
    },
    "start_cp": {
      "minimum": 0,
      "title": "Start Cp",
      "type": "integer"
    },
    "end_cp": {
      "minimum": 0,
      "title": "End Cp",
      "type": "integer"
    },
    "token_start": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Token Start"
    },
    "token_end": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Token End"
    },
    "global_token_start": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Global Token Start"
    },
    "global_token_end": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Global Token End"
    },
    "source_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Url"
    },
    "evidence_id": {
      "title": "Evidence Id",
      "type": "null"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "snapshot_id": {
      "format": "uuid",
      "title": "Snapshot Id",
      "type": "string"
    },
    "result_set_id": {
      "format": "uuid",
      "title": "Result Set Id",
      "type": "string"
    },
    "text": {
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "hit_ref",
    "revision_id",
    "segment_id",
    "origin_kind",
    "document_id",
    "document_name",
    "material_id",
    "material_revision_id",
    "source_id",
    "source_sentence_id",
    "context_start_cp",
    "start_cp",
    "end_cp",
    "token_start",
    "token_end",
    "global_token_start",
    "global_token_end",
    "source_url",
    "evidence_id",
    "project_id",
    "snapshot_id",
    "result_set_id",
    "text"
  ],
  "title": "ContextView",
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {
          "origin_kind": {
            "const": "private"
          }
        }
      },
      "then": {
        "properties": {
          "source_id": {
            "type": "null"
          },
          "source_sentence_id": {
            "type": "null"
          },
          "source_url": {
            "type": "null"
          },
          "material_id": {
            "type": "string",
            "format": "uuid"
          },
          "material_revision_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "else": {
        "properties": {
          "source_id": {
            "type": "string"
          },
          "source_sentence_id": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "material_id": {
            "type": "null"
          },
          "material_revision_id": {
            "type": "null"
          },
          "context_start_cp": {
            "const": 0
          }
        }
      }
    }
  ]
}
