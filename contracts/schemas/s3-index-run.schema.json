{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus.invalid/contracts/s3-index-run.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "source_id": {
      "const": "D12"
    },
    "source_identity": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "entry_kind": {
          "type": "string"
        },
        "official_url": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "publisher",
        "entry_kind",
        "official_url"
      ],
      "additionalProperties": false
    },
    "state": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "progress": {
      "type": "object",
      "properties": {
        "processed_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "total_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "processed_records": {
          "type": "integer",
          "minimum": 0
        },
        "total_records": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "file_name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "processed_bytes",
        "total_bytes",
        "processed_records",
        "total_records",
        "file_name"
      ],
      "additionalProperties": false
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": false
        }
      ]
    },
    "allowed_actions": {
      "type": "object",
      "properties": {
        "cancel": {
          "type": "boolean"
        },
        "retry": {
          "type": "boolean"
        }
      },
      "required": [
        "cancel",
        "retry"
      ],
      "additionalProperties": false
    },
    "acquisition_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "recipe": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "additionalProperties": false
    },
    "stage": {
      "enum": [
        "QUEUED",
        "FETCHING",
        "INDEXING",
        "VERIFYING",
        "STORING",
        "INDEXED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "result": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "index_id": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "state": {
              "const": "INDEXED"
            },
            "searchable": {
              "const": false
            },
            "identity_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "counts": {
              "type": "object"
            },
            "artifact_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "quality": {
              "type": "object"
            }
          },
          "required": [
            "index_id",
            "state",
            "searchable",
            "identity_sha256",
            "manifest_sha256",
            "counts",
            "artifact_bytes",
            "quality"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "id",
    "source_id",
    "source_identity",
    "state",
    "attempt",
    "created_at",
    "updated_at",
    "progress",
    "error",
    "allowed_actions",
    "acquisition_id",
    "recipe",
    "stage",
    "result"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "SUCCEEDED"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "type": "object",
            "properties": {
              "index_id": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "state": {
                "const": "INDEXED"
              },
              "searchable": {
                "const": false
              },
              "identity_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "manifest_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "counts": {
                "type": "object"
              },
              "artifact_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "quality": {
                "type": "object"
              }
            },
            "required": [
              "index_id",
              "state",
              "searchable",
              "identity_sha256",
              "manifest_sha256",
              "counts",
              "artifact_bytes",
              "quality"
            ],
            "additionalProperties": false
          },
          "stage": {
            "const": "INDEXED"
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "result": {
            "type": "null"
          }
        }
      }
    }
  ]
}
