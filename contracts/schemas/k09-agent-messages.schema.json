{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus.invalid/contracts/k09-agent-messages.schema.json",
  "$defs": {
    "AssistantMessage": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "AssistantMessage",
      "type": "object"
    },
    "MessageTurn": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "user_message": {
          "title": "User Message",
          "type": "string"
        },
        "assistant_messages": {
          "items": {
            "$ref": "#/$defs/AssistantMessage"
          },
          "title": "Assistant Messages",
          "type": "array"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/ToolMessage"
          },
          "title": "Tools",
          "type": "array"
        },
        "state": {
          "enum": [
            "QUEUED",
            "RUNNING",
            "WAITING_JOB",
            "WAITING_REVIEW",
            "CANCELLED",
            "SUCCEEDED",
            "FAILED"
          ],
          "title": "State",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "user_message",
        "assistant_messages",
        "tools",
        "state",
        "created_at"
      ],
      "title": "MessageTurn",
      "type": "object"
    },
    "ResultView": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "project",
            "material",
            "snapshot",
            "query",
            "evidence",
            "note",
            "export",
            "job"
          ],
          "title": "Kind",
          "type": "string"
        },
        "resource_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Resource Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "resource_id"
      ],
      "title": "ResultView",
      "type": "object"
    },
    "ToolMessage": {
      "additionalProperties": false,
      "properties": {
        "invocation_id": {
          "format": "uuid",
          "title": "Invocation Id",
          "type": "string"
        },
        "tool_name": {
          "title": "Tool Name",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "result_view": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResultView"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "invocation_id",
        "tool_name",
        "status",
        "result_view"
      ],
      "title": "ToolMessage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/MessageTurn"
      },
      "title": "Items",
      "type": "array"
    },
    "next_before": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Before"
    }
  },
  "required": [
    "items",
    "next_before"
  ],
  "title": "MessageList",
  "type": "object"
}
