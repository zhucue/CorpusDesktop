{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus.invalid/contracts/s1-catalog-create.schema.json",
  "additionalProperties": false,
  "properties": {
    "name": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "publisher": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Publisher",
      "type": "string"
    },
    "entry_kind": {
      "enum": [
        "publisher",
        "aggregator",
        "dataset"
      ],
      "title": "Entry Kind",
      "type": "string"
    },
    "categories": {
      "items": {
        "type": "string"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Categories",
      "type": "array"
    },
    "languages": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Languages",
      "type": "array"
    },
    "official_url": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Official Url",
      "type": "string"
    },
    "materials": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Materials",
      "type": "string"
    },
    "access_route": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Access Route",
      "type": "string"
    },
    "boundary": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Boundary",
      "type": "string"
    },
    "source_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Source Id",
      "type": "string"
    }
  },
  "required": [
    "name",
    "publisher",
    "entry_kind",
    "categories",
    "languages",
    "official_url",
    "materials",
    "access_route",
    "boundary",
    "source_id"
  ],
  "title": "CatalogCreate",
  "type": "object"
}
