{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus.invalid/contracts/s3-research-snapshot.schema.json",
  "$defs": {
    "DocumentUnits": {
      "additionalProperties": false,
      "properties": {
        "source_records": {
          "minimum": 0,
          "title": "Source Records",
          "type": "integer"
        },
        "private_files": {
          "minimum": 0,
          "title": "Private Files",
          "type": "integer"
        }
      },
      "required": [
        "source_records",
        "private_files"
      ],
      "title": "DocumentUnits",
      "type": "object"
    },
    "PrivateSnapshotMember": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "private_revision",
          "title": "Kind",
          "type": "string"
        },
        "material_id": {
          "format": "uuid",
          "title": "Material Id",
          "type": "string"
        },
        "material_revision_id": {
          "format": "uuid",
          "title": "Material Revision Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "language": {
          "enum": [
            "cmn",
            "eng"
          ],
          "title": "Language",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "canonical_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Canonical Sha256",
          "type": "string"
        },
        "recipe": {
          "$ref": "#/$defs/RecipeView"
        }
      },
      "required": [
        "kind",
        "material_id",
        "material_revision_id",
        "revision",
        "language",
        "manifest_sha256",
        "canonical_sha256",
        "recipe"
      ],
      "title": "PrivateSnapshotMember",
      "type": "object"
    },
    "QueryCapabilities": {
      "additionalProperties": false,
      "properties": {
        "character": {
          "const": true,
          "title": "Character",
          "type": "boolean"
        },
        "token_form": {
          "const": true,
          "title": "Token Form",
          "type": "boolean"
        },
        "lemma": {
          "const": false,
          "title": "Lemma",
          "type": "boolean"
        },
        "upos": {
          "const": false,
          "title": "Upos",
          "type": "boolean"
        },
        "regex": {
          "const": false,
          "title": "Regex",
          "type": "boolean"
        },
        "within": {
          "items": {
            "const": "sentence",
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Within",
          "type": "array"
        },
        "context_unit": {
          "const": "codepoint",
          "title": "Context Unit",
          "type": "string"
        }
      },
      "required": [
        "character",
        "token_form",
        "lemma",
        "upos",
        "regex",
        "within",
        "context_unit"
      ],
      "title": "QueryCapabilities",
      "type": "object"
    },
    "RecipeView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "title": "RecipeView",
      "type": "object"
    },
    "ResearchError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "ResearchError",
      "type": "object"
    },
    "ResearchProgress": {
      "additionalProperties": false,
      "properties": {
        "processed_bytes": {
          "minimum": 0,
          "title": "Processed Bytes",
          "type": "integer"
        },
        "total_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Total Bytes"
        },
        "processed_records": {
          "minimum": 0,
          "title": "Processed Records",
          "type": "integer"
        },
        "total_records": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Total Records"
        },
        "file_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "File Name"
        }
      },
      "required": [
        "processed_bytes",
        "total_bytes",
        "processed_records",
        "total_records",
        "file_name"
      ],
      "title": "ResearchProgress",
      "type": "object"
    },
    "SnapshotActions": {
      "additionalProperties": false,
      "properties": {
        "retry": {
          "title": "Retry",
          "type": "boolean"
        }
      },
      "required": [
        "retry"
      ],
      "title": "SnapshotActions",
      "type": "object"
    },
    "SnapshotCounts": {
      "additionalProperties": false,
      "properties": {
        "sentences": {
          "minimum": 0,
          "title": "Sentences",
          "type": "integer"
        },
        "cmn_sentences": {
          "minimum": 0,
          "title": "Cmn Sentences",
          "type": "integer"
        },
        "eng_sentences": {
          "minimum": 0,
          "title": "Eng Sentences",
          "type": "integer"
        },
        "characters": {
          "minimum": 0,
          "title": "Characters",
          "type": "integer"
        },
        "tokens": {
          "minimum": 0,
          "title": "Tokens",
          "type": "integer"
        },
        "direct_edges": {
          "minimum": 0,
          "title": "Direct Edges",
          "type": "integer"
        },
        "unknown_owner": {
          "minimum": 0,
          "title": "Unknown Owner",
          "type": "integer"
        },
        "documents": {
          "minimum": 0,
          "title": "Documents",
          "type": "integer"
        },
        "document_units": {
          "$ref": "#/$defs/DocumentUnits"
        }
      },
      "required": [
        "sentences",
        "cmn_sentences",
        "eng_sentences",
        "characters",
        "tokens",
        "direct_edges",
        "unknown_owner",
        "documents",
        "document_units"
      ],
      "title": "SnapshotCounts",
      "type": "object"
    },
    "SourceSnapshotMember": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "whole_source_mount",
          "title": "Kind",
          "type": "string"
        },
        "mount_id": {
          "format": "uuid",
          "title": "Mount Id",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_snapshot_id": {
          "format": "uuid",
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "release_id": {
          "format": "uuid",
          "title": "Release Id",
          "type": "string"
        },
        "index_id": {
          "format": "uuid",
          "title": "Index Id",
          "type": "string"
        },
        "index_identity_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Index Identity Sha256",
          "type": "string"
        },
        "ordered_members_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Ordered Members Sha256",
          "type": "string"
        },
        "recipe": {
          "$ref": "#/$defs/RecipeView"
        }
      },
      "required": [
        "kind",
        "mount_id",
        "source_id",
        "source_snapshot_id",
        "release_id",
        "index_id",
        "index_identity_sha256",
        "ordered_members_sha256",
        "recipe"
      ],
      "title": "SourceSnapshotMember",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "created_by": {
      "format": "uuid",
      "title": "Created By",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "state": {
      "enum": [
        "PREPARING",
        "READY",
        "FAILED"
      ],
      "title": "State",
      "type": "string"
    },
    "available": {
      "title": "Available",
      "type": "boolean"
    },
    "unavailable_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Unavailable Reason"
    },
    "manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "members": {
      "items": {
        "discriminator": {
          "mapping": {
            "private_revision": "#/$defs/PrivateSnapshotMember",
            "whole_source_mount": "#/$defs/SourceSnapshotMember"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/SourceSnapshotMember"
          },
          {
            "$ref": "#/$defs/PrivateSnapshotMember"
          }
        ]
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Members",
      "type": "array"
    },
    "index_kind": {
      "enum": [
        "source_reuse",
        "project"
      ],
      "title": "Index Kind",
      "type": "string"
    },
    "counts": {
      "anyOf": [
        {
          "$ref": "#/$defs/SnapshotCounts"
        },
        {
          "type": "null"
        }
      ]
    },
    "query_capabilities": {
      "$ref": "#/$defs/QueryCapabilities"
    },
    "progress": {
      "$ref": "#/$defs/ResearchProgress"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResearchError"
        },
        {
          "type": "null"
        }
      ]
    },
    "allowed_actions": {
      "$ref": "#/$defs/SnapshotActions"
    }
  },
  "required": [
    "id",
    "project_id",
    "name",
    "job_id",
    "created_by",
    "created_at",
    "updated_at",
    "state",
    "available",
    "unavailable_reason",
    "manifest_sha256",
    "members",
    "index_kind",
    "counts",
    "query_capabilities",
    "progress",
    "error",
    "allowed_actions"
  ],
  "title": "SnapshotView",
  "type": "object"
}
