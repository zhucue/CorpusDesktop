{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus.invalid/contracts/s3-outcomes-evidence-action.schema.json",
  "$defs": {
    "CharacterQuery": {
      "additionalProperties": false,
      "properties": {
        "dsl_version": {
          "const": "corpus-query/v1",
          "title": "Dsl Version",
          "type": "string"
        },
        "within": {
          "const": "sentence",
          "title": "Within",
          "type": "string"
        },
        "overlap": {
          "const": "all",
          "title": "Overlap",
          "type": "string"
        },
        "normalization": {
          "const": "none",
          "default": "none",
          "title": "Normalization",
          "type": "string"
        },
        "sort": {
          "default": [
            "document_ordinal",
            "start",
            "end"
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "const": "document_ordinal",
              "type": "string"
            },
            {
              "const": "start",
              "type": "string"
            },
            {
              "const": "end",
              "type": "string"
            }
          ],
          "title": "Sort",
          "type": "array"
        },
        "unit": {
          "const": "character",
          "title": "Unit",
          "type": "string"
        },
        "pattern": {
          "anyOf": [
            {
              "$ref": "#/$defs/LiteralPattern"
            },
            {
              "$ref": "#/$defs/CharacterSequence"
            },
            {
              "$ref": "#/$defs/CharacterUnion"
            }
          ],
          "title": "Pattern"
        }
      },
      "required": [
        "dsl_version",
        "within",
        "overlap",
        "unit",
        "pattern"
      ],
      "title": "CharacterQuery",
      "type": "object"
    },
    "CharacterSequence": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "sequence",
          "title": "Type",
          "type": "string"
        },
        "items": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/LiteralPattern"
              },
              {
                "$ref": "#/$defs/GapPattern"
              }
            ]
          },
          "minItems": 2,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "type",
        "items"
      ],
      "title": "CharacterSequence",
      "type": "object"
    },
    "CharacterUnion": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "any_of",
          "title": "Type",
          "type": "string"
        },
        "patterns": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/LiteralPattern"
              },
              {
                "$ref": "#/$defs/CharacterSequence"
              }
            ]
          },
          "minItems": 2,
          "title": "Patterns",
          "type": "array"
        }
      },
      "required": [
        "type",
        "patterns"
      ],
      "title": "CharacterUnion",
      "type": "object"
    },
    "ContextView": {
      "additionalProperties": false,
      "properties": {
        "hit_ref": {
          "$ref": "#/$defs/HitRef"
        },
        "revision_id": {
          "title": "Revision Id",
          "type": "string"
        },
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        },
        "origin_kind": {
          "enum": [
            "source",
            "private"
          ],
          "title": "Origin Kind",
          "type": "string"
        },
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "document_name": {
          "title": "Document Name",
          "type": "string"
        },
        "material_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Material Id"
        },
        "material_revision_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Material Revision Id"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Id"
        },
        "source_sentence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Sentence Id"
        },
        "context_start_cp": {
          "minimum": 0,
          "title": "Context Start Cp",
          "type": "integer"
        },
        "start_cp": {
          "minimum": 0,
          "title": "Start Cp",
          "type": "integer"
        },
        "end_cp": {
          "minimum": 0,
          "title": "End Cp",
          "type": "integer"
        },
        "token_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Token Start"
        },
        "token_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Token End"
        },
        "global_token_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Global Token Start"
        },
        "global_token_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Global Token End"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Url"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "null"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "snapshot_id": {
          "format": "uuid",
          "title": "Snapshot Id",
          "type": "string"
        },
        "result_set_id": {
          "format": "uuid",
          "title": "Result Set Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "hit_ref",
        "revision_id",
        "segment_id",
        "origin_kind",
        "document_id",
        "document_name",
        "material_id",
        "material_revision_id",
        "source_id",
        "source_sentence_id",
        "context_start_cp",
        "start_cp",
        "end_cp",
        "token_start",
        "token_end",
        "global_token_start",
        "global_token_end",
        "source_url",
        "evidence_id",
        "project_id",
        "snapshot_id",
        "result_set_id",
        "text"
      ],
      "title": "ContextView",
      "type": "object"
    },
    "DocumentUnits": {
      "additionalProperties": false,
      "properties": {
        "source_records": {
          "minimum": 0,
          "title": "Source Records",
          "type": "integer"
        },
        "private_files": {
          "minimum": 0,
          "title": "Private Files",
          "type": "integer"
        }
      },
      "required": [
        "source_records",
        "private_files"
      ],
      "title": "DocumentUnits",
      "type": "object"
    },
    "EvidenceView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "created_by": {
          "format": "uuid",
          "title": "Created By",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "query_run_id": {
          "format": "uuid",
          "title": "Query Run Id",
          "type": "string"
        },
        "result_set_id": {
          "format": "uuid",
          "title": "Result Set Id",
          "type": "string"
        },
        "snapshot_id": {
          "format": "uuid",
          "title": "Snapshot Id",
          "type": "string"
        },
        "hit_ref": {
          "$ref": "#/$defs/HitRef"
        },
        "context": {
          "$ref": "#/$defs/ContextView"
        },
        "method": {
          "$ref": "#/$defs/QueryMethod"
        },
        "context_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Context Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "project_id",
        "created_by",
        "created_at",
        "query_run_id",
        "result_set_id",
        "snapshot_id",
        "hit_ref",
        "context",
        "method",
        "context_sha256"
      ],
      "title": "EvidenceView",
      "type": "object"
    },
    "GapPattern": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "gap",
          "title": "Type",
          "type": "string"
        },
        "min": {
          "minimum": 0,
          "title": "Min",
          "type": "integer"
        },
        "max": {
          "minimum": 0,
          "title": "Max",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "min",
        "max"
      ],
      "title": "GapPattern",
      "type": "object"
    },
    "HitRef": {
      "additionalProperties": false,
      "properties": {
        "result_set_id": {
          "format": "uuid",
          "title": "Result Set Id",
          "type": "string"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        }
      },
      "required": [
        "result_set_id",
        "ordinal"
      ],
      "title": "HitRef",
      "type": "object"
    },
    "LiteralPattern": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "literal",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "LiteralPattern",
      "type": "object"
    },
    "QueryCounts": {
      "additionalProperties": false,
      "properties": {
        "count_state": {
          "enum": [
            "pending",
            "complete",
            "failed"
          ],
          "title": "Count State",
          "type": "string"
        },
        "total_hits": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Total Hits"
        },
        "matched_segments": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Matched Segments"
        },
        "matched_documents": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Matched Documents"
        },
        "document_count_unit": {
          "enum": [
            "imported_sentence_record",
            "uploaded_file",
            "mixed_document_units"
          ],
          "title": "Document Count Unit",
          "type": "string"
        },
        "matched_document_units": {
          "anyOf": [
            {
              "$ref": "#/$defs/DocumentUnits"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "count_state",
        "total_hits",
        "matched_segments",
        "matched_documents",
        "document_count_unit",
        "matched_document_units"
      ],
      "title": "QueryCounts",
      "type": "object"
    },
    "QueryMethod": {
      "additionalProperties": false,
      "properties": {
        "query_run_id": {
          "format": "uuid",
          "title": "Query Run Id",
          "type": "string"
        },
        "result_set_id": {
          "format": "uuid",
          "title": "Result Set Id",
          "type": "string"
        },
        "snapshot_id": {
          "format": "uuid",
          "title": "Snapshot Id",
          "type": "string"
        },
        "query": {
          "discriminator": {
            "mapping": {
              "character": "#/$defs/CharacterQuery",
              "token": "#/$defs/TokenQuery"
            },
            "propertyName": "unit"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CharacterQuery"
            },
            {
              "$ref": "#/$defs/TokenQuery"
            }
          ],
          "title": "Query"
        },
        "query_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Query Sha256",
          "type": "string"
        },
        "recipe": {
          "$ref": "#/$defs/RecipeView"
        },
        "counts": {
          "$ref": "#/$defs/QueryCounts"
        },
        "result_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Sha256",
          "type": "string"
        },
        "index_identity_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Index Identity Sha256",
          "type": "string"
        }
      },
      "required": [
        "query_run_id",
        "result_set_id",
        "snapshot_id",
        "query",
        "query_sha256",
        "recipe",
        "counts",
        "result_sha256",
        "index_identity_sha256"
      ],
      "title": "QueryMethod",
      "type": "object"
    },
    "RecipeView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "title": "RecipeView",
      "type": "object"
    },
    "TermPattern": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "term",
          "title": "Type",
          "type": "string"
        },
        "attr": {
          "const": "form",
          "title": "Attr",
          "type": "string"
        },
        "op": {
          "const": "eq",
          "title": "Op",
          "type": "string"
        },
        "value": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "attr",
        "op",
        "value"
      ],
      "title": "TermPattern",
      "type": "object"
    },
    "TokenQuery": {
      "additionalProperties": false,
      "properties": {
        "dsl_version": {
          "const": "corpus-query/v1",
          "title": "Dsl Version",
          "type": "string"
        },
        "within": {
          "const": "sentence",
          "title": "Within",
          "type": "string"
        },
        "overlap": {
          "const": "all",
          "title": "Overlap",
          "type": "string"
        },
        "normalization": {
          "const": "none",
          "default": "none",
          "title": "Normalization",
          "type": "string"
        },
        "sort": {
          "default": [
            "document_ordinal",
            "start",
            "end"
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "const": "document_ordinal",
              "type": "string"
            },
            {
              "const": "start",
              "type": "string"
            },
            {
              "const": "end",
              "type": "string"
            }
          ],
          "title": "Sort",
          "type": "array"
        },
        "unit": {
          "const": "token",
          "title": "Unit",
          "type": "string"
        },
        "pattern": {
          "anyOf": [
            {
              "$ref": "#/$defs/TermPattern"
            },
            {
              "$ref": "#/$defs/TokenSequence"
            },
            {
              "$ref": "#/$defs/TokenUnion"
            }
          ],
          "title": "Pattern"
        }
      },
      "required": [
        "dsl_version",
        "within",
        "overlap",
        "unit",
        "pattern"
      ],
      "title": "TokenQuery",
      "type": "object"
    },
    "TokenSequence": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "sequence",
          "title": "Type",
          "type": "string"
        },
        "items": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/TermPattern"
              },
              {
                "$ref": "#/$defs/GapPattern"
              }
            ]
          },
          "minItems": 2,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "type",
        "items"
      ],
      "title": "TokenSequence",
      "type": "object"
    },
    "TokenUnion": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "any_of",
          "title": "Type",
          "type": "string"
        },
        "patterns": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/TermPattern"
              },
              {
                "$ref": "#/$defs/TokenSequence"
              }
            ]
          },
          "minItems": 2,
          "title": "Patterns",
          "type": "array"
        }
      },
      "required": [
        "type",
        "patterns"
      ],
      "title": "TokenUnion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "format": "uuid",
      "title": "Action Id",
      "type": "string"
    },
    "existing": {
      "title": "Existing",
      "type": "boolean"
    },
    "evidence": {
      "$ref": "#/$defs/EvidenceView"
    }
  },
  "required": [
    "action_id",
    "existing",
    "evidence"
  ],
  "title": "EvidenceAction",
  "type": "object"
}
