{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus.invalid/contracts/s3-scoped-job-ref.schema.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "job_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "sync_run_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        }
      },
      "required": [
        "sync_run_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "index_run_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        }
      },
      "required": [
        "index_run_id"
      ],
      "additionalProperties": false
    }
  ],
  "$comment": "Trusted session scope chooses the branch. Schema validity never grants platform or project access."
}
