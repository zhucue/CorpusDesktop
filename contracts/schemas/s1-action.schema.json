{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus.invalid/contracts/s1-action.schema.json",
  "type": "object",
  "properties": {
    "action_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "operation": {
      "enum": [
        "uploads.create",
        "uploads.complete",
        "jobs.cancel",
        "jobs.retry"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "agent": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "invocation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "run_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "invocation_id",
            "run_id"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "action_id",
    "project_id",
    "actor_id",
    "operation",
    "idempotency_key",
    "request_sha256",
    "agent"
  ],
  "additionalProperties": false,
  "$comment": "Actor and optional agent linkage are trusted ledger fields, never client-authorized identity. Manual actions do not require agent linkage; internal host execution records its own trusted invocation/run linkage."
}
