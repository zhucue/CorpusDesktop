{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus.invalid/contracts/s1-source-list.schema.json",
  "type": "object",
  "properties": {
    "q": {
      "type": "string",
      "maxLength": 160
    },
    "language": {
      "type": "string",
      "maxLength": 48
    },
    "category": {
      "type": "string",
      "maxLength": 48
    },
    "status": {
      "enum": [
        "catalog_only",
        "verification_pending",
        "experimental_evidence"
      ]
    },
    "capability": {
      "enum": [
        "discover",
        "remote_query",
        "fulltext_analysis",
        "export",
        "model_egress"
      ]
    },
    "cursor": {
      "type": "string",
      "maxLength": 512
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": [],
  "additionalProperties": false
}
