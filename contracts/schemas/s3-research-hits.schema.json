{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus.invalid/contracts/s3-research-hits.schema.json",
  "$defs": {
    "ContextWindow": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "const": "codepoint",
          "title": "Unit",
          "type": "string"
        },
        "before": {
          "maximum": 200,
          "minimum": 0,
          "title": "Before",
          "type": "integer"
        },
        "after": {
          "maximum": 200,
          "minimum": 0,
          "title": "After",
          "type": "integer"
        }
      },
      "required": [
        "unit",
        "before",
        "after"
      ],
      "title": "ContextWindow",
      "type": "object"
    },
    "DocumentUnits": {
      "additionalProperties": false,
      "properties": {
        "source_records": {
          "minimum": 0,
          "title": "Source Records",
          "type": "integer"
        },
        "private_files": {
          "minimum": 0,
          "title": "Private Files",
          "type": "integer"
        }
      },
      "required": [
        "source_records",
        "private_files"
      ],
      "title": "DocumentUnits",
      "type": "object"
    },
    "HitRef": {
      "additionalProperties": false,
      "properties": {
        "result_set_id": {
          "format": "uuid",
          "title": "Result Set Id",
          "type": "string"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        }
      },
      "required": [
        "result_set_id",
        "ordinal"
      ],
      "title": "HitRef",
      "type": "object"
    },
    "HitView": {
      "additionalProperties": false,
      "properties": {
        "hit_ref": {
          "$ref": "#/$defs/HitRef"
        },
        "revision_id": {
          "title": "Revision Id",
          "type": "string"
        },
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        },
        "origin_kind": {
          "enum": [
            "source",
            "private"
          ],
          "title": "Origin Kind",
          "type": "string"
        },
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "document_name": {
          "title": "Document Name",
          "type": "string"
        },
        "material_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Material Id"
        },
        "material_revision_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Material Revision Id"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Id"
        },
        "source_sentence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Sentence Id"
        },
        "context_start_cp": {
          "minimum": 0,
          "title": "Context Start Cp",
          "type": "integer"
        },
        "start_cp": {
          "minimum": 0,
          "title": "Start Cp",
          "type": "integer"
        },
        "end_cp": {
          "minimum": 0,
          "title": "End Cp",
          "type": "integer"
        },
        "token_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Token Start"
        },
        "token_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Token End"
        },
        "global_token_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Global Token Start"
        },
        "global_token_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Global Token End"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Url"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "null"
        },
        "left": {
          "title": "Left",
          "type": "string"
        },
        "match": {
          "title": "Match",
          "type": "string"
        },
        "right": {
          "title": "Right",
          "type": "string"
        }
      },
      "required": [
        "hit_ref",
        "revision_id",
        "segment_id",
        "origin_kind",
        "document_id",
        "document_name",
        "material_id",
        "material_revision_id",
        "source_id",
        "source_sentence_id",
        "context_start_cp",
        "start_cp",
        "end_cp",
        "token_start",
        "token_end",
        "global_token_start",
        "global_token_end",
        "source_url",
        "evidence_id",
        "left",
        "match",
        "right"
      ],
      "title": "HitView",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "origin_kind": {
                "const": "private"
              }
            }
          },
          "then": {
            "properties": {
              "source_id": {
                "type": "null"
              },
              "source_sentence_id": {
                "type": "null"
              },
              "source_url": {
                "type": "null"
              },
              "material_id": {
                "type": "string",
                "format": "uuid"
              },
              "material_revision_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          "else": {
            "properties": {
              "source_id": {
                "type": "string"
              },
              "source_sentence_id": {
                "type": "string"
              },
              "source_url": {
                "type": "string"
              },
              "material_id": {
                "type": "null"
              },
              "material_revision_id": {
                "type": "null"
              },
              "context_start_cp": {
                "const": 0
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "count_state": {
      "enum": [
        "pending",
        "complete",
        "failed"
      ],
      "title": "Count State",
      "type": "string"
    },
    "total_hits": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Total Hits"
    },
    "matched_segments": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Matched Segments"
    },
    "matched_documents": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Matched Documents"
    },
    "document_count_unit": {
      "enum": [
        "imported_sentence_record",
        "uploaded_file",
        "mixed_document_units"
      ],
      "title": "Document Count Unit",
      "type": "string"
    },
    "matched_document_units": {
      "anyOf": [
        {
          "$ref": "#/$defs/DocumentUnits"
        },
        {
          "type": "null"
        }
      ]
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "snapshot_id": {
      "format": "uuid",
      "title": "Snapshot Id",
      "type": "string"
    },
    "result_set_id": {
      "format": "uuid",
      "title": "Result Set Id",
      "type": "string"
    },
    "query_run_id": {
      "format": "uuid",
      "title": "Query Run Id",
      "type": "string"
    },
    "hits": {
      "items": {
        "$ref": "#/$defs/HitView"
      },
      "maxItems": 50,
      "title": "Hits",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Cursor"
    },
    "has_more": {
      "title": "Has More",
      "type": "boolean"
    },
    "page_state": {
      "enum": [
        "pending",
        "ready"
      ],
      "title": "Page State",
      "type": "string"
    },
    "completeness": {
      "enum": [
        "preview",
        "complete"
      ],
      "title": "Completeness",
      "type": "string"
    },
    "sort": {
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "const": "document_ordinal",
          "type": "string"
        },
        {
          "const": "start",
          "type": "string"
        },
        {
          "const": "end",
          "type": "string"
        }
      ],
      "title": "Sort",
      "type": "array"
    },
    "context": {
      "$ref": "#/$defs/ContextWindow"
    }
  },
  "required": [
    "count_state",
    "total_hits",
    "matched_segments",
    "matched_documents",
    "document_count_unit",
    "matched_document_units",
    "project_id",
    "snapshot_id",
    "result_set_id",
    "query_run_id",
    "hits",
    "next_cursor",
    "has_more",
    "page_state",
    "completeness",
    "sort",
    "context"
  ],
  "title": "HitPage",
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {
          "count_state": {
            "const": "complete"
          }
        }
      },
      "then": {
        "properties": {
          "total_hits": {
            "type": "integer",
            "minimum": 0
          },
          "matched_segments": {
            "type": "integer",
            "minimum": 0
          },
          "matched_documents": {
            "type": "integer",
            "minimum": 0
          },
          "matched_document_units": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "total_hits": {
            "type": "null"
          },
          "matched_segments": {
            "type": "null"
          },
          "matched_documents": {
            "type": "null"
          },
          "matched_document_units": {
            "type": "null"
          }
        }
      }
    }
  ]
}
