{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus.invalid/contracts/s1-accepted-upload.schema.json",
  "type": "object",
  "properties": {
    "status": {
      "const": "accepted"
    },
    "action_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "upload_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "state": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "CANCEL_REQUESTED",
        "CANCELLED",
        "SUCCEEDED",
        "FAILED"
      ]
    },
    "result_ref": {
      "type": "null"
    }
  },
  "required": [
    "status",
    "action_id",
    "job_id",
    "upload_id",
    "state",
    "result_ref"
  ],
  "additionalProperties": false
}
