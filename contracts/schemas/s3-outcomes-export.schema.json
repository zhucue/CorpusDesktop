{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus.invalid/contracts/s3-outcomes-export.schema.json",
  "$defs": {
    "ExportActions": {
      "additionalProperties": false,
      "properties": {
        "cancel": {
          "title": "Cancel",
          "type": "boolean"
        },
        "retry": {
          "title": "Retry",
          "type": "boolean"
        },
        "download": {
          "title": "Download",
          "type": "boolean"
        }
      },
      "required": [
        "cancel",
        "retry",
        "download"
      ],
      "title": "ExportActions",
      "type": "object"
    },
    "ExportResult": {
      "additionalProperties": false,
      "properties": {
        "filename": {
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "media_type": {
          "enum": [
            "application/zip",
            "application/json"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "container": {
          "enum": [
            "zip",
            "file"
          ],
          "title": "Container",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        }
      },
      "required": [
        "filename",
        "media_type",
        "container",
        "byte_size",
        "sha256",
        "manifest_sha256",
        "row_count"
      ],
      "title": "ExportResult",
      "type": "object"
    },
    "NoteExportTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "note_revision",
          "title": "Kind",
          "type": "string"
        },
        "note_id": {
          "format": "uuid",
          "title": "Note Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "note_id",
        "revision"
      ],
      "title": "NoteExportTarget",
      "type": "object"
    },
    "QueryExportTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "query_runs",
          "title": "Kind",
          "type": "string"
        },
        "query_run_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Query Run Ids",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "query_run_ids"
      ],
      "title": "QueryExportTarget",
      "type": "object"
    },
    "ResearchError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "ResearchError",
      "type": "object"
    },
    "ResearchProgress": {
      "additionalProperties": false,
      "properties": {
        "processed_bytes": {
          "minimum": 0,
          "title": "Processed Bytes",
          "type": "integer"
        },
        "total_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Total Bytes"
        },
        "processed_records": {
          "minimum": 0,
          "title": "Processed Records",
          "type": "integer"
        },
        "total_records": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Total Records"
        },
        "file_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "File Name"
        }
      },
      "required": [
        "processed_bytes",
        "total_bytes",
        "processed_records",
        "total_records",
        "file_name"
      ],
      "title": "ResearchProgress",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "actor_id": {
      "format": "uuid",
      "title": "Actor Id",
      "type": "string"
    },
    "target": {
      "discriminator": {
        "mapping": {
          "note_revision": "#/$defs/NoteExportTarget",
          "query_runs": "#/$defs/QueryExportTarget"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/QueryExportTarget"
        },
        {
          "$ref": "#/$defs/NoteExportTarget"
        }
      ],
      "title": "Target"
    },
    "format": {
      "enum": [
        "csv",
        "json"
      ],
      "title": "Format",
      "type": "string"
    },
    "state": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "State",
      "type": "string"
    },
    "stage": {
      "enum": [
        "QUEUED",
        "EXPORTING",
        "STORING",
        "COMPLETE",
        "FAILED",
        "CANCELLED"
      ],
      "title": "Stage",
      "type": "string"
    },
    "attempt": {
      "minimum": 0,
      "title": "Attempt",
      "type": "integer"
    },
    "progress": {
      "$ref": "#/$defs/ResearchProgress"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResearchError"
        },
        {
          "type": "null"
        }
      ]
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExportResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "allowed_actions": {
      "$ref": "#/$defs/ExportActions"
    }
  },
  "required": [
    "id",
    "job_id",
    "project_id",
    "actor_id",
    "target",
    "format",
    "state",
    "stage",
    "attempt",
    "progress",
    "error",
    "result",
    "created_at",
    "updated_at",
    "allowed_actions"
  ],
  "title": "ExportView",
  "type": "object"
}
