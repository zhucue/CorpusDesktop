{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus.invalid/contracts/s3-index-build.schema.json",
  "type": "object",
  "properties": {
    "source_id": {
      "const": "D12"
    },
    "acquisition_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    }
  },
  "required": [
    "source_id",
    "acquisition_id"
  ],
  "additionalProperties": false
}
