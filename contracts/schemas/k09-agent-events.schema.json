{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus.invalid/contracts/k09-agent-events.schema.json",
  "$defs": {
    "AgentEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "sequence",
        "kind",
        "payload",
        "created_at"
      ],
      "title": "AgentEvent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/AgentEvent"
      },
      "title": "Items",
      "type": "array"
    },
    "next_after": {
      "minimum": 0,
      "title": "Next After",
      "type": "integer"
    }
  },
  "required": [
    "items",
    "next_after"
  ],
  "title": "EventList",
  "type": "object"
}
