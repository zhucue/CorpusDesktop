{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus.invalid/contracts/s2-sync-run.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "source_id": {
      "const": "D12"
    },
    "connector_id": {
      "type": "string"
    },
    "source_revision": {
      "type": "integer",
      "minimum": 1
    },
    "source_identity": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "entry_kind": {
          "type": "string"
        },
        "official_url": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "publisher",
        "entry_kind",
        "official_url"
      ],
      "additionalProperties": false
    },
    "state": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "stage": {
      "enum": [
        "QUEUED",
        "ACQUIRING",
        "PARSING",
        "STORING",
        "VALIDATED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "progress": {
      "type": "object",
      "properties": {
        "processed_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "total_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "processed_records": {
          "type": "integer",
          "minimum": 0
        },
        "total_records": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "file_name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "processed_bytes",
        "total_bytes",
        "processed_records",
        "total_records",
        "file_name"
      ],
      "additionalProperties": false
    },
    "result": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "acquisition_id": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "state": {
              "const": "VALIDATED"
            },
            "searchable": {
              "const": false
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "export_date": {
              "type": [
                "string",
                "null"
              ]
            },
            "quality": {
              "type": "object"
            },
            "diff": {
              "type": "object"
            },
            "license": {
              "type": "object"
            }
          },
          "required": [
            "acquisition_id",
            "state",
            "searchable",
            "manifest_sha256",
            "export_date",
            "quality",
            "diff",
            "license"
          ],
          "additionalProperties": false
        }
      ]
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": false
        }
      ]
    },
    "allowed_actions": {
      "type": "object",
      "properties": {
        "cancel": {
          "type": "boolean"
        },
        "retry": {
          "type": "boolean"
        }
      },
      "required": [
        "cancel",
        "retry"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "source_id",
    "connector_id",
    "source_revision",
    "source_identity",
    "state",
    "stage",
    "attempt",
    "created_at",
    "updated_at",
    "progress",
    "result",
    "error",
    "allowed_actions"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "SUCCEEDED"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "type": "object",
            "properties": {
              "acquisition_id": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "state": {
                "const": "VALIDATED"
              },
              "searchable": {
                "const": false
              },
              "manifest_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "export_date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "quality": {
                "type": "object"
              },
              "diff": {
                "type": "object"
              },
              "license": {
                "type": "object"
              }
            },
            "required": [
              "acquisition_id",
              "state",
              "searchable",
              "manifest_sha256",
              "export_date",
              "quality",
              "diff",
              "license"
            ],
            "additionalProperties": false
          },
          "stage": {
            "const": "VALIDATED"
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "result": {
            "type": "null"
          }
        }
      }
    }
  ]
}
