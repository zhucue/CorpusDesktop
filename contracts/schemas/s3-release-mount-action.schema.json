{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus.invalid/contracts/s3-release-mount-action.schema.json",
  "type": "object",
  "properties": {
    "action_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "existing": {
      "type": "boolean"
    },
    "mount": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "removed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Removed At"
        },
        "state": {
          "enum": [
            "ACTIVE",
            "REMOVED"
          ],
          "title": "State",
          "type": "string"
        },
        "release": {
          "$ref": "#/$defs/ReleaseView"
        },
        "allowed_actions": {
          "$ref": "#/$defs/MountActions"
        }
      },
      "required": [
        "id",
        "project_id",
        "created_at",
        "removed_at",
        "state",
        "release",
        "allowed_actions"
      ],
      "title": "MountView",
      "type": "object"
    }
  },
  "required": [
    "action_id",
    "existing",
    "mount"
  ],
  "additionalProperties": false,
  "$defs": {
    "IndexCounts": {
      "additionalProperties": false,
      "properties": {
        "sentences": {
          "minimum": 0,
          "title": "Sentences",
          "type": "integer"
        },
        "cmn_sentences": {
          "minimum": 0,
          "title": "Cmn Sentences",
          "type": "integer"
        },
        "eng_sentences": {
          "minimum": 0,
          "title": "Eng Sentences",
          "type": "integer"
        },
        "characters": {
          "minimum": 0,
          "title": "Characters",
          "type": "integer"
        },
        "tokens": {
          "minimum": 0,
          "title": "Tokens",
          "type": "integer"
        },
        "direct_edges": {
          "minimum": 0,
          "title": "Direct Edges",
          "type": "integer"
        },
        "unknown_owner": {
          "minimum": 0,
          "title": "Unknown Owner",
          "type": "integer"
        }
      },
      "required": [
        "sentences",
        "cmn_sentences",
        "eng_sentences",
        "characters",
        "tokens",
        "direct_edges",
        "unknown_owner"
      ],
      "title": "IndexCounts",
      "type": "object"
    },
    "IndexQuality": {
      "additionalProperties": false,
      "properties": {
        "all_source_sentences_indexed": {
          "title": "All Source Sentences Indexed",
          "type": "boolean"
        },
        "rejected_sentences": {
          "minimum": 0,
          "title": "Rejected Sentences",
          "type": "integer"
        },
        "token_roundtrip_verified": {
          "title": "Token Roundtrip Verified",
          "type": "boolean"
        },
        "attributes": {
          "items": {
            "const": "form",
            "type": "string"
          },
          "title": "Attributes",
          "type": "array"
        },
        "document_count_unit": {
          "const": "imported_sentence_record",
          "title": "Document Count Unit",
          "type": "string"
        },
        "normalization": {
          "const": "none",
          "title": "Normalization",
          "type": "string"
        }
      },
      "required": [
        "all_source_sentences_indexed",
        "rejected_sentences",
        "token_roundtrip_verified",
        "attributes",
        "document_count_unit",
        "normalization"
      ],
      "title": "IndexQuality",
      "type": "object"
    },
    "MountActions": {
      "additionalProperties": false,
      "properties": {
        "read_manifest": {
          "title": "Read Manifest",
          "type": "boolean"
        },
        "remove": {
          "title": "Remove",
          "type": "boolean"
        }
      },
      "required": [
        "read_manifest",
        "remove"
      ],
      "title": "MountActions",
      "type": "object"
    },
    "RecipeView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "title": "RecipeView",
      "type": "object"
    },
    "ReleaseView": {
      "additionalProperties": false,
      "properties": {
        "release_id": {
          "format": "uuid",
          "title": "Release Id",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_snapshot_id": {
          "format": "uuid",
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "index_id": {
          "format": "uuid",
          "title": "Index Id",
          "type": "string"
        },
        "acquisition_id": {
          "format": "uuid",
          "title": "Acquisition Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "published_at": {
          "format": "date-time",
          "title": "Published At",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "index_identity_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Index Identity Sha256",
          "type": "string"
        },
        "recipe": {
          "$ref": "#/$defs/RecipeView"
        },
        "counts": {
          "$ref": "#/$defs/IndexCounts"
        },
        "quality": {
          "$ref": "#/$defs/IndexQuality"
        },
        "policy_revision": {
          "minimum": 1,
          "title": "Policy Revision",
          "type": "integer"
        },
        "current_policy_revision": {
          "minimum": 0,
          "title": "Current Policy Revision",
          "type": "integer"
        },
        "state": {
          "const": "PUBLISHED",
          "title": "State",
          "type": "string"
        },
        "searchable": {
          "title": "Searchable",
          "type": "boolean"
        },
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unavailable Reason"
        }
      },
      "required": [
        "release_id",
        "source_id",
        "source_snapshot_id",
        "index_id",
        "acquisition_id",
        "version",
        "published_at",
        "manifest_sha256",
        "index_identity_sha256",
        "recipe",
        "counts",
        "quality",
        "policy_revision",
        "current_policy_revision",
        "state",
        "searchable",
        "available",
        "unavailable_reason"
      ],
      "title": "ReleaseView",
      "type": "object"
    }
  }
}
