{
  "name": "@corpus/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.15.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "dev": "node --env-file-if-exists=.env src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@hono/node-server": "^2.1.5",
    "@openuidev/lang-core": "1.0.1",
    "hono": "^4.13.14",
    "pg": "^8.23.1",
    "typebox": "1.3.27",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "typescript": "5.9.3"
  }
}
