# Official node:24.15.0-bookworm-slim, pinned by the parent integration build.
FROM node@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d
WORKDIR /app
COPY services/agent-runtime/package.json services/agent-runtime/package-lock.json /app/services/agent-runtime/
RUN npm ci --prefix services/agent-runtime --ignore-scripts --omit=dev
COPY services/agent-runtime/src /app/services/agent-runtime/src
COPY contracts/types /app/contracts/types
RUN mkdir -p /app/tmp/agent-host && chown -R node:node /app/tmp
USER node
EXPOSE 8081
CMD ["node", "services/agent-runtime/src/k09-daemon.ts"]
