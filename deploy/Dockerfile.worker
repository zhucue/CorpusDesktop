FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv UV_LINK_MODE=copy PATH=/opt/venv/bin:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl libpcre3 libglib2.0-0 libreadline8 \
 && rm -rf /var/lib/apt/lists/*
RUN curl -L --fail --retry 5 --retry-all-errors https://downloads.sourceforge.net/project/cwb/cwb/cwb-3.5/deb/cwb_3.5.0-1_amd64.deb -o /tmp/cwb.deb \
 && echo '257ef6f71a055ee70cd57904173e40f8e8f0e6c93ac7edf5d7d2e3a21c023601  /tmp/cwb.deb' | sha256sum -c - \
 && dpkg -i /tmp/cwb.deb && rm /tmp/cwb.deb
RUN pip install --no-cache-dir uv==0.11.21
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
RUN useradd --create-home --uid 10001 corpus && mkdir -p /data /stanza && chown corpus:corpus /data /stanza
COPY engine engine
COPY services/api services/api
COPY services/worker services/worker
USER corpus
# Stanza 模型首次使用时下载到 /stanza 卷
CMD ["python", "-m", "services.worker.main"]
