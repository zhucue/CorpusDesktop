# Local S0 examples only. Generate private local values with scripts/init_dev_env.py.
CORPUS_DB_PASSWORD=replace-for-local-development
CORPUS_BROKER_PASSWORD=replace-for-local-development
CORPUS_S3_PASSWORD=replace-for-local-development
CORPUS_HTTP_PORT=18080

# Model configuration is server-owned. Leave unconfigured until explicitly set.
CORPUS_AGENT_RUNTIME_MODE=unconfigured
AGENT_MODEL_API=
AGENT_MODEL_BASE_URL=
AGENT_MODEL_ID=
AGENT_MODEL_CONTEXT_WINDOW=8192
AGENT_MODEL_MAX_OUTPUT_TOKENS=1024
AGENT_MODEL_REQUEST_TIMEOUT_MS=60000
# Only for synthetic loopback protocol tests; keep false for a remote service.
AGENT_MODEL_ALLOW_LOOPBACK_HTTP=false
# Node host only; never forwarded to API or written into model/session reports.
AGENT_MODEL_API_KEY=
