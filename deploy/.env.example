# 复制为 deploy/.env 后填写；.env 不入库
POSTGRES_PASSWORD=
# 宿主机端口（只绑定 127.0.0.1）
POSTGRES_PORT=15432
HTTP_PORT=8080
# 浏览器访问地址；非 GET 请求的 Origin 须与之一致，多个用逗号分隔
PUBLIC_ORIGIN=http://localhost:8080
# agent 对话模型（OpenAI 兼容接口）；留空时助手不可用
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_ID=
# openai-completions | openai-responses，留空为 openai-completions
MODEL_API=
# 知识库向量模型：local（默认，paraphrase-multilingual-MiniLM-L12-v2，首次启动下载约 0.5 GB 到 models 卷）
# 或 openai（OpenAI 兼容 /embeddings，维度须为 384）
EMBED_PROVIDER=
EMBED_MODEL=
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_DIM=
# 短任务门槛（可选）：上传小于该字节数的导入、词数小于该值的建索引由 worker-light 也可处理，且所有 worker 优先处理
LIGHT_IMPORT_BYTES=
LIGHT_INDEX_TOKENS=
