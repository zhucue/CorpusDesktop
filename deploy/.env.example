# 复制为 deploy/.env 后填写；.env 不入库
POSTGRES_PASSWORD=
# 宿主机端口（只绑定 127.0.0.1）
POSTGRES_PORT=15432
HTTP_PORT=8080
# 浏览器访问地址；非 GET 请求的 Origin 须与之一致，多个用逗号分隔
PUBLIC_ORIGIN=http://localhost:8080
# agent 对话模型（OpenAI 兼容接口）；留空时助手不可用
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_ID=
# openai-completions | openai-responses，留空为 openai-completions
MODEL_API=
# 知识库向量模型：local（默认，paraphrase-multilingual-MiniLM-L12-v2，首次启动下载约 0.5 GB 到 models 卷）
# 或 openai（OpenAI 兼容 /embeddings，维度须为 384）
EMBED_PROVIDER=
EMBED_MODEL=
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_DIM=
# 短任务门槛（可选）：上传小于该字节数的导入、词数小于该值的建索引由 worker-light 也可处理，且所有 worker 优先处理
LIGHT_IMPORT_BYTES=
LIGHT_INDEX_TOKENS=
# 版本号（设置页显示），留空为 dev
APP_VERSION=
# scripts/healthcheck.sh 检查失败时 POST 告警的地址（可选，留空只打印）
ALERT_WEBHOOK_URL=
# 服务器时区（api、worker、agent），模型用量按此时区的自然月统计；留空为 Asia/Shanghai
TZ=
# 每位用户每月对话模型 token 上限（助手、片段预标、文献摘要、术语抽取合计），0 或留空为不限
LLM_MONTHLY_TOKENS_PER_USER=
# 每位用户同时运行的助手对话数，留空为 2
AGENT_MAX_RUNS_PER_USER=
# 删除的项目可恢复天数（之后自动清除），留空为 7；导出文件保留天数，留空为 30
PROJECT_PURGE_DAYS=
EXPORT_RETENTION_DAYS=
# worker-light 每日维护（清除超期项目、过期导出与失败上传）：1 开启（默认），0 关闭
WORKER_MAINTENANCE=
# 宿主机备份目录（scripts/backup.sh 输出位置，绝对路径），只读挂载给 api 显示最近备份时间；留空为仓库 tmp/backups
BACKUP_DIR=
# worker 同时加载的 Stanza 语言管线数（每种约 330 MB 内存；小内存机器设 1）
STANZA_MAX_PIPELINES=2
# 每个语料语义索引的句数上限
SEMANTIC_MAX_SENTENCES=300000
# 压缩格式（DOCX / XLSX / PDF / bz2）解压后总字节、文件数、PDF 页数上限
MAX_UNPACKED_BYTES=524288000
MAX_UNPACKED_FILES=10000
MAX_PDF_PAGES=5000
