FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 SQLITE_TMPDIR=/app/tmp/index-build TMPDIR=/app/tmp/index-build
RUN mkdir -p /app/tmp/index-build && apt-get update && apt-get install -y --no-install-recommends ca-certificates curl libpcre3 libglib2.0-0 libreadline8 && rm -rf /var/lib/apt/lists/*
RUN curl --fail --location --retry 2 --max-time 180 https://downloads.sourceforge.net/project/cwb/cwb/cwb-3.5/deb/cwb_3.5.0-1_amd64.deb -o /app/tmp/cwb.deb && echo '257ef6f71a055ee70cd57904173e40f8e8f0e6c93ac7edf5d7d2e3a21c023601  /app/tmp/cwb.deb' | sha256sum -c - && dpkg -i /app/tmp/cwb.deb && rm /app/tmp/cwb.deb
COPY deploy/requirements.txt /app/requirements.txt
COPY pipelines/query/source-index-requirements.txt /app/source-index-requirements.txt
COPY pipelines/query/source-index-build-requirements.txt /app/source-index-build-requirements.txt
RUN pip install --no-cache-dir --require-hashes -r source-index-build-requirements.txt && pip install --no-cache-dir --no-build-isolation --require-hashes -r source-index-requirements.txt && pip install --no-cache-dir --require-hashes -r requirements.txt
RUN useradd --create-home --uid 10001 corpus && mkdir -p /app/tmp/research-cache && chown -R corpus:corpus /app/tmp
COPY services/api /app/services/api
COPY workers /app/workers
COPY pipelines /app/pipelines
COPY contracts /app/contracts
COPY scripts /app/scripts
USER corpus
CMD ["python", "-m", "celery", "-A", "workers.app", "worker", "--loglevel=INFO", "--concurrency=1", "--queues=corpus.index", "--hostname=index@%h"]
